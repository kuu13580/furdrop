{
  "name": "furdrop",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "check": "biome check .",
    "fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "prepare": "git config core.hooksPath scripts/hooks",
    "generate": "dotenvx run -- node scripts/generate-config.mjs",
    "generate:prod": "dotenvx run -f .env.prod -- node scripts/generate-config.mjs",
    "secrets:prod": "dotenvx run -f .env.prod -- node scripts/deploy-secrets.mjs",
    "cors:prod": "node scripts/apply-r2-cors.mjs",
    "seed": "node scripts/seed.mjs",
    "dev": "concurrently -n front,api -c cyan,magenta \"pnpm --filter frontend dev\" \"pnpm --filter workers dev\"",
    "emulator": "firebase emulators:start --only auth --project demo-furdrop",
    "emulator:exec": "firebase emulators:exec --only auth --project demo-furdrop",
    "test": "pnpm test:frontend && pnpm emulator:exec \"pnpm test:workers && pnpm test:e2e\"",
    "test:frontend": "pnpm --filter frontend test",
    "test:workers": "pnpm emulator:exec \"pnpm --filter workers test\"",
    "test:e2e": "pnpm emulator:exec \"pnpm --filter e2e test\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "esbuild",
      "protobufjs",
      "workerd"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@dotenvx/dotenvx": "^1.61.0",
    "concurrently": "^9.2.1",
    "firebase-tools": "^14.0.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
