{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "i18n:extract": "lingui extract --clean",
    "i18n:check": "lingui extract --clean && lingui compile --strict",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lingui/core": "^6.6.0",
    "@lingui/react": "^6.6.0",
    "@tailwindcss/vite": "^4.2.2",
    "@zip.js/zip.js": "^2.8.26",
    "firebase": "^12.12.0",
    "heic-to": "^1.4.2",
    "jotai": "^2.19.1",
    "piexifjs": "^1.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "9.0.3",
    "react-router": "^7.14.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@lingui/babel-plugin-lingui-macro": "6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@lingui/vite-plugin": "^6.6.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@types/node": "^25.5.2",
    "@types/piexifjs": "^1.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "vitest": "^3.0.0"
  }
}
